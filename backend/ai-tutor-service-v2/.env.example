
APP_NAME=Jlearn AI Tutor
APP_VERSION=1.0.0
APP_ENV=development
API_PREFIX=/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-model-placeholder
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

